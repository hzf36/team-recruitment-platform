# Copy to .env before `docker compose up` (do not commit .env).
# Placeholders only — never put production secrets here.

# Required. JWT signing secret (server-side only).
JWT_SECRET=replace-with-a-long-random-string

# Optional. Host port published for the app (default 8080).
# APP_PORT=8080

# Optional TEST-ONLY. Force GET /api/auth/me to return this HTTP status
# (e.g. 500) for identity-init fault probes. Leave unset/empty for normal use.
# AUTH_ME_FORCE_ERROR=
